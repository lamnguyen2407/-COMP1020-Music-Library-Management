<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===== TOP NAVBAR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0" style="-fx-background-color: #f5f5f5;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="16" right="16" top="10" />
            </padding>

            <!-- Logo -->
            <Label style="-fx-font-size: 26px;" text="🎵" />

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" prefWidth="280.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #d0d0d0; -fx-border-width: 1;">
                <padding>
                    <Insets bottom="8" left="14" right="14" top="8" />
                </padding>
                <Label style="-fx-text-fill: #999999; -fx-font-size: 13px;" text="🎤" />
                <TextField prefWidth="220.0" promptText="Search for songs" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #333333;" />
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- User Profile -->
            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <VBox alignment="CENTER_RIGHT">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Rachelly Proovra" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Your Profile" />
                </VBox>
                <StackPane prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: #c0a080; -fx-background-radius: 50;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="R" />
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox prefHeight="700.0" prefWidth="150.0" spacing="4.0" style="-fx-background-color: #f5f5f5;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="16" left="8" right="8" top="8" />
            </padding>

            <Button maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #555555; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-cursor: hand;" text="🏠  Home" />
            <Button maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #e8e8e8; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="👤  Account" />
            <Button maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #555555; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-cursor: hand;" text="🔍  Search" />
            <Button maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #555555; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-cursor: hand;" text="📊  Playlists" />

            <!-- Push Settings to bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-text-fill: #555555; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 8; -fx-cursor: hand;" text="⚙  Settings" />
        </VBox>
    </left>

    <!-- ===== CENTER CONTENT — ACCOUNT PAGE ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f5f5f5;" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24" />
            </padding>
            <content>
                <VBox spacing="22.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 2);">
                    <padding>
                        <Insets bottom="36" left="40" right="40" top="32" />
                    </padding>

                    <!-- Page Title -->
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Account" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Please update your profile settings here" />
                    </VBox>

                    <!-- Username Row -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label prefWidth="130.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Username" />
                        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #f8f8f8; -fx-border-color: #d5d5d5; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <TextField prefWidth="180.0" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 10 12 10 8; -fx-font-size: 13px;" text="ABC" />
                        </HBox>
                    </HBox>

                    <!-- Phone Number Row -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label prefWidth="130.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Phone Number" />
                        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #f8f8f8; -fx-border-color: #d5d5d5; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label style="-fx-padding: 10 10 10 12; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-border-color: #d5d5d5; -fx-border-width: 0 1 0 0;" text="🇬🇧 +44" />
                            <TextField prefWidth="200.0" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 10 12 10 8; -fx-font-size: 13px;" text="(158) 008-9987" />
                        </HBox>
                    </HBox>

                    <!-- Profile Picture Row -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label prefWidth="130.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Profile Picture" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Button mnemonicParsing="false" style="-fx-background-color: #5a5a5a; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 18 8 18; -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;" text="Edit" />
                            <Button mnemonicParsing="false" style="-fx-background-color: #c0854a; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 18 8 18; -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;" text="Delete" />
                        </HBox>
                    </HBox>

                    <!-- Biography Row -->
                    <HBox alignment="TOP_LEFT" spacing="20.0">
                        <Label prefWidth="130.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 8 0 0 0;" text="Biography" />
                        <VBox spacing="4.0">
                            <TextArea prefHeight="100.0" prefWidth="360.0" promptText="Write a short description to introduce yourself" style="-fx-background-color: #f8f8f8; -fx-border-color: #d5d5d5; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 10;" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;" text="300 characters remaining" />
                        </VBox>
                    </HBox>

                    <!-- Cancel / Save Buttons -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button mnemonicParsing="false" style="-fx-background-color: #f0f0f0; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 9 22 9 22; -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;" text="✕  Cancel" />
                        <Button mnemonicParsing="false" style="-fx-background-color: #c0854a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22 9 22; -fx-background-radius: 20; -fx-border-width: 0; -fx-cursor: hand;" text="✓  Save" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
