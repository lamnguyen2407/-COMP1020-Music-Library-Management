<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="720.0" style="-fx-background-color: #fdfaf7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===== TOP NAVBAR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="10.0" style="-fx-background-color: #fdfaf7; -fx-border-color: #e8e0d8; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <!-- Logo -->
            <StackPane prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: #c07840; -fx-background-radius: 7;">
                <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="♪" />
            </StackPane>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2a2a2a;" text="Souleea" />

            <!-- Warm blob top-right decoration -->
            <Region HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />

            <!-- Sign Up button -->
            <Button mnemonicParsing="false" style="-fx-background-color: #c07840; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 16; -fx-border-width: 0; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="👤  Sign Up" />
        </HBox>
    </top>

    <!-- ===== CENTER — HERO CONTENT ===== -->
    <center>
        <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #fdfaf7;" BorderPane.alignment="CENTER">

            <!-- LEFT: Text + CTA -->
            <VBox alignment="CENTER_LEFT" spacing="20.0" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="40" left="60" right="20" top="40" />
                </padding>

                <!-- Headline -->
                <Label prefHeight="130.0" prefWidth="419.0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-line-spacing: 2;" text="Enjoy your streaming experience" wrapText="true" />

                <Region prefHeight="10.0" />

                <!-- CTA Button -->
                <Button mnemonicParsing="false" style="-fx-background-color: #c07840; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-width: 0; -fx-padding: 12 28 12 28; -fx-cursor: hand;" text="Try loging in" />
            </VBox>

            <!-- RIGHT: Headphones image -->
            <StackPane prefHeight="380.0" prefWidth="340.0" HBox.hgrow="ALWAYS">
                <ImageView fx:id="heroImage" fitHeight="340.0" fitWidth="320.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 6);" />
            </StackPane>

        </HBox>
    </center>

</BorderPane>
