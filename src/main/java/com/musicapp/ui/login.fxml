<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    style="-fx-background-color: #fdf8f5;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1">

    <!-- Decorative top-right gradient blob -->
    <Region
        prefWidth="280.0"
        prefHeight="180.0"
        style="-fx-background-color: radial-gradient(center 100% 0%, radius 60%, rgba(210,160,130,0.45), transparent);"
        StackPane.alignment="TOP_RIGHT" />

    <VBox
        alignment="TOP_CENTER"
        spacing="0"
        maxWidth="380.0"
        StackPane.alignment="CENTER">

        <!-- ── LOGO / HEADER ── -->
        <HBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="18" top="22" />
            </padding>
            <!-- Logo icon placeholder -->
            <StackPane
                prefWidth="32.0" prefHeight="32.0"
                style="-fx-background-color: #c07840; -fx-background-radius: 8;">
                <Label text="♪" style="-fx-text-fill: white; -fx-font-size: 16px;" />
            </StackPane>
            <Label text="Souleea"
                style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
        </HBox>

        <!-- ── FORM AREA ── -->
        <VBox spacing="10.0" maxWidth="360.0">
            <padding>
                <Insets bottom="24" left="10" right="10" top="28" />
            </padding>

            <!-- Continue with Facebook -->
            <Button
                text="f   CONTINUE WITH FACEBOOK"
                maxWidth="Infinity"
                mnemonicParsing="false"
                style="-fx-background-color: #c07840; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-width: 0; -fx-padding: 12 20 12 20; -fx-cursor: hand; -fx-letter-spacing: 1;" />

            <!-- Continue with Apple -->
            <Button
                text="  CONTINUE WITH APPLE"
                maxWidth="Infinity"
                mnemonicParsing="false"
                style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-width: 0; -fx-padding: 12 20 12 20; -fx-cursor: hand;" />

            <!-- Continue with Google -->
            <Button
                text="CONTINUE WITH GOOGLE"
                maxWidth="Infinity"
                mnemonicParsing="false"
                style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 12 20 12 20; -fx-cursor: hand;" />

            <!-- OR divider -->
            <HBox alignment="CENTER" spacing="10.0">
                <padding><Insets top="4" bottom="4" /></padding>
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #dddddd;" />
                <Label text="OR" style="-fx-font-size: 11px; -fx-text-fill: #aaaaaa;" />
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #dddddd;" />
            </HBox>

            <!-- Email label + field -->
            <Label text="Email address or username"
                style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <TextField
                fx:id="emailField"
                promptText="Email address or username"
                style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-font-size: 13px;" />

            <!-- Password label + field -->
            <Label text="Password"
                style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <PasswordField
                fx:id="passwordField"
                promptText="Password"
                style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-font-size: 13px;" />

            <!-- Forgot password -->
            <Label
                text="Forgot your password?"
                style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-underline: true; -fx-cursor: hand;" />

            <!-- Remember me + LOG IN row -->
            <HBox alignment="CENTER_LEFT" spacing="0">
                <CheckBox
                    fx:id="rememberMe"
                    text="Remember me"
                    selected="true"
                    style="-fx-font-size: 12px; -fx-text-fill: #555555;"
                    mnemonicParsing="false"
                    HBox.hgrow="ALWAYS" />
                <Button
                    fx:id="loginBtn"
                    text="LOG IN"
                    mnemonicParsing="false"
                    style="-fx-background-color: #c07840; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-width: 0; -fx-padding: 11 28 11 28; -fx-cursor: hand;" />
            </HBox>

            <!-- Divider -->
            <Separator style="-fx-background-color: #dddddd;">
                <VBox.margin><Insets top="6" bottom="6" /></VBox.margin>
            </Separator>

            <!-- Don't have an account -->
            <Label
                text="Don't have an account?"
                maxWidth="Infinity"
                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-alignment: CENTER;" />

            <!-- Sign up button -->
            <Button
                text="SIGN UP FOR SOULEEA"
                maxWidth="Infinity"
                mnemonicParsing="false"
                style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 12 20 12 20; -fx-cursor: hand;" />

        </VBox>
    </VBox>
</StackPane>