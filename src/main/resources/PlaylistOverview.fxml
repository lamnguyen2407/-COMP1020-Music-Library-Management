<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musicapp.ui.PlaylistOverviewController"
      style="-fx-background-color: #FAF7F4;"
      spacing="0">

    <Label text="Playlists" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C1810;">
        <VBox.margin>
            <Insets top="32" left="32" bottom="20" right="32"/>
        </VBox.margin>
    </Label>

    <ScrollPane fx:id="playlistScrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">

        <VBox fx:id="playlistListContainer" spacing="0" style="-fx-background-color: #FAF7F4;">
            <padding>
                <Insets left="32" right="32" bottom="16"/>
            </padding>

            <HBox fx:id="favoriteRow" styleClass="playlist-row" alignment="CENTER_LEFT" spacing="16" minHeight="80" style="-fx-cursor: hand;">
                <padding><Insets top="8" bottom="8"/></padding>
                <HBox alignment="CENTER" minWidth="56" minHeight="56" style="-fx-background-color: #C0703A; -fx-background-radius: 8;">
                    <Label text="♥" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                </HBox>
                <Label text="Your favorite songs" style="-fx-font-size: 16px; -fx-text-fill: #2C1810;" HBox.hgrow="ALWAYS"/>
                <Label text="›" style="-fx-font-size: 20px; -fx-text-fill: #9E8E84;"/>
            </HBox>

            <Region fx:id="favSeparator" minHeight="1" prefHeight="1" style="-fx-background-color: #E0D8D0;"/>

            <HBox fx:id="newPlaylistRow" onMouseClicked="#onNewPlaylistClicked" alignment="CENTER_LEFT" spacing="16" minHeight="80" style="-fx-cursor: hand;">
                <padding><Insets top="8" bottom="8"/></padding>
                <HBox alignment="CENTER" minWidth="56" minHeight="56" style="-fx-background-color: #E0D8D0; -fx-background-radius: 8;">
                    <Label text="+" style="-fx-font-size: 24px; -fx-text-fill: #7A6A60;"/>
                </HBox>
                <Label text="New PlayList" style="-fx-font-size: 16px; -fx-text-fill: #2C1810;" HBox.hgrow="ALWAYS"/>
                <Label text="›" style="-fx-font-size: 20px; -fx-text-fill: #9E8E84;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>