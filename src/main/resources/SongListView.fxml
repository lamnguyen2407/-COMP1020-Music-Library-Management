<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musicapp.ui.SongListController" 
      spacing="0"
      style="-fx-background-color: #FAF7F4;">

    <HBox spacing="40" style="-fx-background-color: #FAF7F4; -fx-padding: 32 40 24 40;">
        <ImageView fx:id="coverImageView"
                   fitHeight="230" fitWidth="230"
                   preserveRatio="false"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 4);" />

        <VBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C1810;" text="All Songs" />
            <Label fx:id="subtitleLabel" style="-fx-font-size: 15px; -fx-text-fill: #C0703A; -fx-font-style: italic;" text="Library Management" />
            
            <Region prefHeight="10" />
            <Label fx:id="descriptionLabel" maxWidth="500" wrapText="true" 
                   style="-fx-font-size: 13px; -fx-text-fill: #7A6A60; -fx-line-spacing: 3;" 
                   text="Admin can add new tracks or remove existing ones from the system." />
            
            <Region prefHeight="16" />
            
            <HBox spacing="12">
                <Button fx:id="playButton" text="PLAY" prefHeight="38" prefWidth="120" 
                        style="-fx-background-color: #C0703A; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                
                <Button fx:id="shuffleButton" text="SHUFFLE" prefHeight="38" prefWidth="120" 
                        style="-fx-background-color: transparent; -fx-text-fill: #C0703A; -fx-border-color: #C0703A; -fx-font-weight: bold; -fx-cursor: hand;" />

                <Button fx:id="addBtn" onAction="#onAddSongClicked" text="ADD" prefHeight="38" prefWidth="120" 
                        style="-fx-background-color: #C0703A; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                
                <Button fx:id="deleteBtn" onAction="#onDeleteToggleClicked" text="DELETE" prefHeight="38" prefWidth="120" 
                        style="-fx-background-color: #C0703A; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </HBox>

    <Separator style="-fx-opacity: 0.3;"><padding><Insets left="40" right="40" /></padding></Separator>

    <HBox style="-fx-background-color: #FAF7F4; -fx-padding: 12 40 8 40;">
        <Label fx:id="checkHeader" prefWidth="30" text="[ ]" visible="false" managed="false"/>
        
        <Label prefWidth="36" text="#" style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;" />
        <Label fx:id="col1Header" prefWidth="300" text="SONG" style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;" />
        <Label fx:id="col2Header" prefWidth="180" text="ARTIST" style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;" />
        <Label fx:id="col3Header" prefWidth="200" text="ALBUM" style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
        <Label prefWidth="60" text="TIME" style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;" />
    </HBox>

    <ListView fx:id="songListView" fixedCellSize="62" VBox.vgrow="ALWAYS" 
              style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0 40 20 40; -fx-border-color: transparent;" />
</VBox>