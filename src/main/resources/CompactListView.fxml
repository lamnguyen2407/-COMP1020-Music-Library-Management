<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musicapp.ui.CompactListController"      
      spacing="0"
      style="-fx-background-color: #FAF7F4;">

    <Label fx:id="titleLabel"
           text=""
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C1810; -fx-padding: 32 40 24 40;"/>

    <HBox style="-fx-padding: 8 40 8 40;">
        <Region prefWidth="46"/>
        
        <Label text="SONG"
               prefWidth="360"
               style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;"/>
               
        <Label text="ARTIST"
               prefWidth="200"
               style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;"/>
               
        <Label text="ALBUM"
               prefWidth="220"
               HBox.hgrow="ALWAYS"
               style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;"/>
               
        <Label text="TIME"
               prefWidth="60"
               style="-fx-font-size: 11px; -fx-text-fill: #9E8E84; -fx-font-weight: bold;"/>
    </HBox>

    <Separator style="-fx-opacity: 0.2;">
        <padding>
            <Insets left="40" right="40"/>
        </padding>
    </Separator>

    <ListView fx:id="songListView"
              VBox.vgrow="ALWAYS"
              fixedCellSize="62"
              style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0 40 20 40; -fx-border-color: transparent;">
    </ListView>

</VBox>