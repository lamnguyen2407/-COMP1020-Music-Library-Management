<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<StackPane
    style="-fx-background-color: linear-gradient(to bottom, #d4bfb0, #c4a898, #b89080);"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.PlaybackViewController">

    <VBox
        alignment="TOP_CENTER"
        spacing="0"
        maxWidth="560.0"
        StackPane.alignment="CENTER">

        <!-- Album Art — wide, short, landscape -->
        <StackPane
            prefWidth="560.0"
            prefHeight="300.0">

            <ImageView
                fx:id="albumArtView"
                fitWidth="560.0"
                fitHeight="300.0"
                preserveRatio="false"
                style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 16, 0, 0, 4);" />

            <!-- Progress bar overlapping bottom of image -->
            <ProgressBar
                fx:id="progressBar"
                prefWidth="530.0"
                prefHeight="3.0"
                progress="0.45"
                style="-fx-accent: #d4845a; -fx-background-color: rgba(255,255,255,0.4); -fx-background-radius: 2;"
                StackPane.alignment="BOTTOM_CENTER">
                <StackPane.margin>
                    <Insets bottom="10" />
                </StackPane.margin>
            </ProgressBar>

        </StackPane>

        <!-- Controls + Title area -->
        <VBox
            alignment="CENTER"
            spacing="0"
            style="-fx-background-color: linear-gradient(to bottom, #b89080, #a87870);"
            prefWidth="560.0">

            <padding>
                <Insets bottom="20" left="24" right="24" top="14" />
            </padding>

            <!-- Playback Controls Row -->
            <HBox alignment="CENTER" spacing="28.0">

                <Button
                    fx:id="shuffleBtn"
                    text="⇄"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75); -fx-cursor: hand; -fx-padding: 4;"
                    mnemonicParsing="false" />

                <Button
                    fx:id="prevBtn"
                    text="⏮"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 18px; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 4;"
                    mnemonicParsing="false" />

                <!-- Play circle -->
                <StackPane
                    prefWidth="46.0"
                    prefHeight="46.0"
                    style="-fx-background-color: #d4845a; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0, 0, 2); -fx-cursor: hand;">
                    <Button
                        fx:id="playBtn"
                        text="▶"
                        style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 17px; -fx-text-fill: white; -fx-padding: 0; -fx-cursor: hand;"
                        mnemonicParsing="false" />
                </StackPane>

                <Button
                    fx:id="nextBtn"
                    text="⏭"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 18px; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 4;"
                    mnemonicParsing="false" />

                <Button
                    fx:id="repeatBtn"
                    text="↻"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75); -fx-cursor: hand; -fx-padding: 4;"
                    mnemonicParsing="false" />

            </HBox>

            <Region prefHeight="14.0" />

            <!-- Song Title -->
            <Label
                fx:id="songTitleLabel"
                text="Young And Beautiful"
                style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />

            <Region prefHeight="4.0" />

            <!-- Artist -->
            <Label
                fx:id="artistLabel"
                text="Lana Del Rey"
                style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.60);" />

        </VBox>
    </VBox>
</StackPane>