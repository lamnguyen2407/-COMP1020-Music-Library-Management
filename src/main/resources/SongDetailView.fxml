<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane
    style="-fx-background-color: linear-gradient(to bottom, #d4bfb0, #c4a898, #b89080);"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.musicapp.ui.PlaybackViewController">

    <VBox alignment="TOP_CENTER" spacing="0" maxWidth="560.0" StackPane.alignment="CENTER">

        <StackPane prefWidth="560.0" prefHeight="300.0">
            <ImageViewff
                fx:id="albumArtView"
                fitWidth="560.0" fitHeight="300.0"
                preserveRatio="false"
                style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 16, 0, 0, 4);" />

            <ProgressBar
                fx:id="progressBar"
                prefWidth="530.0" prefHeight="4.0"
                progress="0.0"
                style="-fx-accent: #C0703A;"
                StackPane.alignment="BOTTOM_CENTER">
                <StackPane.margin><Insets bottom="10" /></StackPane.margin>
            </ProgressBar>
        </StackPane>

        <VBox alignment="CENTER" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #b89080, #a87870);" prefWidth="560.0">
            <padding><Insets bottom="20" left="24" right="24" top="14" /></padding>

            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="genreLabel" text="Pop" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 10; -fx-padding: 2 8 2 8;" />
                <Label fx:id="yearLabel" text="2026" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;" />
            </HBox>
            
            <Region prefHeight="10" />

            <HBox alignment="CENTER" spacing="28.0">
                <Button onAction="#onShuffle" text="⇄" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" />
                <Button onAction="#onPrev" text="⏮" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 22px; -fx-cursor: hand;" />
                
                <StackPane style="-fx-background-color: #C0703A; -fx-background-radius: 50; -fx-cursor: hand;" prefSize="50, 50" onMouseClicked="#onPlayPause">
                    <Label fx:id="playBtnIcon" text="▶" style="-fx-text-fill: white; -fx-font-size: 20px;" />
                </StackPane>

                <Button onAction="#onNext" text="⏭" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 22px; -fx-cursor: hand;" />
                <Button onAction="#onRepeat" text="↻" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" />
            </HBox>

            <Region prefHeight="14.0" />

            <Label fx:id="songTitleLabel" text="Song Title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label fx:id="artistLabel" text="Artist Name" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.7);" />

            <Region prefHeight="15" />
            
            <Button fx:id="editSongBtn" text="EDIT SONG INFO" onAction="#onEditSong"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 10px; -fx-border-radius: 5;" />
        </VBox>
    </VBox>
</StackPane>