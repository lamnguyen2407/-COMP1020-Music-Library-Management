<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700" prefWidth="860" spacing="0" 
      xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.musicapp.ui.CreatePlaylistModalController"
      style="-fx-background-color: #FAF7F4;">

    <HBox alignment="CENTER" minHeight="56" style="-fx-background-color: #FAF7F4; -fx-border-color: #E0D8D0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets left="28" right="28" />
        </padding>

        <Button onAction="#onCancelClicked" text="Cancel" 
                style="-fx-background-color: transparent; -fx-text-fill: #7A6A60; -fx-cursor: hand; -fx-font-size: 14px;"/>

        <Region HBox.hgrow="ALWAYS" />
        <Label text="New Playlist" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C1810;" />
        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#handleSavePlaylist" text="Done" 
                style="-fx-background-color: transparent; -fx-text-fill: #C0703A; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>
    </HBox>

    <VBox alignment="TOP_CENTER" spacing="0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="40" top="36" />
        </padding>

        <StackPane fx:id="playlistCoverContainer" maxHeight="300" maxWidth="300" minHeight="300" minWidth="300">
            <VBox fx:id="playlistCoverBox" alignment="CENTER" minHeight="300" minWidth="300" 
                  style="-fx-background-color: #D2B48C; -fx-background-radius: 12; -fx-cursor: hand;">
                <children>
                    <ImageView fx:id="uploadedImageView" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="false" />
                    <Label text="Click to upload cover" style="-fx-text-fill: white; -fx-font-size: 13px;" />
                </children>
            </VBox>
        </StackPane>

        <Region minHeight="24" />
        <Label text="Playlist Name" style="-fx-text-fill: #9E8E84; -fx-font-size: 12px;" />
        <Region minHeight="8" />

        <TextField fx:id="playlistNameField" maxWidth="380" promptText="Give your playlist a name"
                   style="-fx-background-color: transparent; -fx-border-color: #E0D8D0; -fx-border-width: 0 0 1 0; -fx-padding: 5 0 5 0; -fx-font-size: 16px;"/>
    </VBox>
</VBox>