<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color: #fdfaf7;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.musicapp.ui.AlbumViewController">

    <!-- ── ALBUM HEADER ── -->
    <HBox spacing="32" style="-fx-background-color: #fdfaf7;">
        <padding><Insets bottom="32" left="40" right="40" top="32" /></padding>

        <!-- Album art -->
        <ImageView fx:id="albumArtView" fitHeight="200.0" fitWidth="200.0" preserveRatio="true"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0, 0, 6);" />

        <!-- Album info -->
        <VBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="albumNameLabel"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
                   text="Album Name" wrapText="true" />
            <Label fx:id="artistLabel"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"
                   text="Artist" />
            <Label fx:id="metaLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;"
                   text="Genre • Year" />
            <Region prefHeight="12.0" />
            <Button fx:id="playBtn" mnemonicParsing="false" onAction="#handlePlay"
                    style="-fx-background-color: #c07840; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 6; -fx-border-width: 0;
                           -fx-padding: 10 32 10 32; -fx-cursor: hand;"
                    text="PLAY" />
        </VBox>
    </HBox>

    <!-- ── SONG LIST HEADER ── -->
    <HBox style="-fx-border-color: #e8e0d8; -fx-border-width: 1 0 1 0;">
        <padding><Insets bottom="8" left="40" right="40" top="8" /></padding>
        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;
                      -fx-letter-spacing: 1px;" text="SONG" />
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="TIME" />
    </HBox>

    <!-- ── SONG ROWS ── -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="songListContainer" spacing="0"
              style="-fx-background-color: #fdfaf7;" />
    </ScrollPane>

</VBox>
