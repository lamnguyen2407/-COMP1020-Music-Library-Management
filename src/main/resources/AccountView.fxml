<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.musicapp.ui.AccountController">
    <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

    <!-- Title -->
    <Label text="Account"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />

    <Region prefHeight="16" />

    <!-- Card -->
    <VBox style="-fx-border-color: #c8e0f7; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;">

        <!-- Role row -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 14 20 14 20;">
            <Label text="Role: " style="-fx-font-size: 13px; -fx-text-fill: #555555;" />
            <Label fx:id="roleLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #555555;" />
        </HBox>
        <Separator />

        <!-- Username row -->
        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 14 20 14 20;">
            <Label text="Username" prefWidth="220"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
            <!-- View mode -->
            <Label fx:id="usernameDisplay" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #1a1a1a;" />
            <!-- Edit mode -->
            <TextField fx:id="usernameField" promptText="Your username here"
                       managed="false" visible="false"
                       prefWidth="380"
                       style="-fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-border-color: #dddddd; -fx-border-width: 1;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;" />
        </HBox>
        <Separator />

        <!-- Email row -->
        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 14 20 14 20;">
            <Label text="Email" prefWidth="220"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
            <Label fx:id="emailDisplay" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #1a1a1a;" />
            <TextField fx:id="emailField" promptText="Your email here"
                       managed="false" visible="false"
                       prefWidth="380"
                       style="-fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-border-color: #dddddd; -fx-border-width: 1;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;" />
        </HBox>
        <Separator />

        <!-- Name row -->
        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 14 20 14 20;">
            <Label text="Name" prefWidth="220"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />
            <Label fx:id="nameDisplay" text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #1a1a1a;" />
            <TextField fx:id="nameField" promptText="Your name here"
                       managed="false" visible="false"
                       prefWidth="380"
                       style="-fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-border-color: #dddddd; -fx-border-width: 1;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;" />
        </HBox>
        <Separator />

        <!-- Buttons row -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 14 20 14 20;">

            <!-- View mode: Edit button -->
            <Button fx:id="editBtn" text="Edit" onAction="#handleEdit"
                    style="-fx-background-color: #c07840; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-border-width: 0;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;" />

            <!-- Edit mode: Cancel + Save -->
            <Button fx:id="cancelBtn" text="✕  Cancel" onAction="#handleCancel"
                    managed="false" visible="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #333333;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-border-radius: 20;
                           -fx-border-color: #cccccc; -fx-border-width: 1;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;" />
            <Button fx:id="saveBtn" text="✓  Save" onAction="#handleSave"
                    managed="false" visible="false"
                    style="-fx-background-color: #c07840; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-border-width: 0;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;" />
        </HBox>

    </VBox>
</VBox>
