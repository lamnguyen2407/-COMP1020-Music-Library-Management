<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color: #fdfaf7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicapp.ui.UserPlaylistViewController">

    <!-- ── HEADER ── -->
    <HBox spacing="32" style="-fx-background-color: #fdfaf7;">
        <padding><Insets bottom="32" left="40" right="40" top="32" /></padding>

        <ImageView fx:id="coverArtView" fitHeight="180.0" fitWidth="180.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0, 0, 6);" />

        <VBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="playlistNameLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="Playlist Name" />
            <Label fx:id="songCountLabel" style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="0 songs" />

            <HBox spacing="12">
                <padding><Insets top="8" /></padding>
                <!-- PLAY button -->
                <Button fx:id="playBtn" onAction="#handlePlay" style="-fx-background-color: #c07840; -fx-text-fill: white;                                -fx-font-size: 13px; -fx-font-weight: bold;                                -fx-background-radius: 6; -fx-border-width: 0;                                -fx-padding: 10 32 10 32; -fx-cursor: hand;" text="PLAY" />
                <!-- DELETE / CONFIRM button -->
                <Button fx:id="deleteBtn" onAction="#handleDelete" style="-fx-background-color: #b84c20; -fx-text-fill: white;                                -fx-font-size: 13px; -fx-font-weight: bold;                                -fx-background-radius: 6; -fx-border-width: 0;                                -fx-padding: 10 32 10 32; -fx-cursor: hand;" text="DELETE" />
            </HBox>
        </VBox>
    </HBox>

    <!-- ── COLUMN HEADERS ── -->
    <HBox style="-fx-border-color: #e8e0d8; -fx-border-width: 1 0 1 0; -fx-padding: 8 40 8 40;">
        <Label fx:id="checkboxHeaderSpacer" managed="false" prefWidth="32" text="" visible="false" />
        <Label prefWidth="40" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="#" />
        <Label prefHeight="16.0" prefWidth="295.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="SONG" />
        <Label prefHeight="16.0" prefWidth="163.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="ARTIST" />
        <Label prefWidth="140" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="GENRE" />
        <Region HBox.hgrow="ALWAYS" />
        <Label prefHeight="16.0" prefWidth="39.0" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #999999;" text="TIME" />
    </HBox>

    <!-- ── SONG LIST ── -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <VBox fx:id="songListContainer" spacing="0" style="-fx-background-color: #fdfaf7;" />
    </ScrollPane>

</VBox>
