<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" prefWidth="520.0" minWidth="450.0"
      style="-fx-background-color: #FAF7F4; -fx-border-color: #D2B48C; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15;" 
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.musicapp.ui.AddSongModalController">
    
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <VBox spacing="5.0">
        <Label text="ADD NEW TRACK" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C1810;" />
        <Label text="Fill in details to update the music library" style="-fx-font-size: 12px; -fx-text-fill: #7A6A60;" />
        <Separator prefWidth="200.0" style="-fx-padding: 10 0 10 0;" />
    </VBox>

    <GridPane vgap="15.0" hgap="15.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="titleField" promptText="Song name" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="admin-input"/>

        <Label text="Artist:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="artistField" promptText="Singer/Band" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="admin-input"/>

        <Label text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="genreField" promptText="Pop, Rock, EDM..." GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="admin-input"/>

        <Label text="Release Year:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="yearField" promptText="2026" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="admin-input"/>

        <Label text="Duration (sec):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="durationField" promptText="e.g. 180" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="admin-input"/>

        <Label text="Audio URL:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="audioUrlField" promptText="Direct link to mp3" 
                   GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="admin-input"/>

        <Label text="Image URL:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="imageUrlField" promptText="Direct link to image" 
                   GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="admin-input"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" prefHeight="20"/>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button onAction="#onCancel" text="CANCEL" 
                style="-fx-background-color: transparent; -fx-text-fill: #7A6A60; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button fx:id="saveBtn" onAction="#onSave" text="SAVE TO DATABASE" prefHeight="45" prefWidth="200" 
                style="-fx-background-color: #C0703A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" />
    </HBox>
</VBox>