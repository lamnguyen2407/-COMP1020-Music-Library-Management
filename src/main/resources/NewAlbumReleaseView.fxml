<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F0EB;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicapp.ui.NewAlbumReleaseController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="40.0">
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <StackPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #EAEAEA; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
               <children>
                  <Label text="💿" textFill="#A0A0A0">
                     <font>
                        <Font size="80.0" />
                     </font>
                  </Label>
                  <ImageView fx:id="headerImageView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="false">
                     <clip>
                        <Rectangle arcHeight="32.0" arcWidth="32.0" height="200.0" width="200.0" />
                     </clip>
                  </ImageView>
               </children>
            </StackPane>

            <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="ALL ALBUMS" textFill="#1A1A1A">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>
                  <Label text="Library Management" textFill="#888888">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Admin can add or remove albums from the global library here." textFill="#888888" wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>

                  <HBox spacing="15.0">
                     <children>
                        <Button fx:id="addAlbumBtn" mnemonicParsing="false" style="-fx-background-color: #2C1810; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 35 12 35; -fx-background-radius: 25; -fx-cursor: hand;" text="ADD ALBUM" />
                        <Button fx:id="deleteAlbumBtn" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: #2C1810; -fx-border-radius: 25; -fx-text-fill: #2C1810; -fx-font-weight: bold; -fx-padding: 10 35 10 35; -fx-border-width: 2; -fx-cursor: hand;" text="DELETE" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="albumContainer" hgap="25.0" vgap="25.0" prefWrapLength="800.0">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="10.0" />
               </padding>
            </FlowPane>
         </content>
      </ScrollPane>
   </children>
</VBox>