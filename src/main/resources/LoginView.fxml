<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #fdf8f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicapp.ui.LoginController">
   <children>

       <!-- Decorative top-right gradient blob -->
       <Region maxHeight="180.0" maxWidth="280.0" prefHeight="180.0" prefWidth="280.0" style="-fx-background-color: radial-gradient(center 100% 0%, radius 60%, rgba(210,160,130,0.45), transparent);" StackPane.alignment="TOP_RIGHT" />

       <!-- Centered card VBox -->
       <VBox alignment="TOP_CENTER" maxWidth="380.0" prefWidth="380.0" spacing="0">
           <StackPane.margin>
               <Insets top="40.0" />
           </StackPane.margin>
           <children>

              <!-- ── LOGO / HEADER ── -->
              <HBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                  <padding>
                      <Insets bottom="18" top="22" />
                  </padding>
                  <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #c07840; -fx-background-radius: 8;">
                      <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="♪" />
                  </StackPane>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Souleea" />
              </HBox>

              <!-- ── FORM AREA ── -->
              <VBox prefWidth="360.0" spacing="10.0">
                  <padding>
                      <Insets bottom="24" left="10" right="10" top="28" />
                  </padding>
                  <children>

                     <!-- Email label + field -->
                     <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Your email adress" />
                     <TextField fx:id="emailField" onAction="#handleLogin" promptText="Your email adress" style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-font-size: 13px;" />

                     <!-- Password label + field -->
                     <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Password" />
                     <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Password" style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-font-size: 13px;" />
                     <StackPane prefHeight="40.0" prefWidth="360.0">
                        <children>
                           <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" prefWidth="118.0" style="-fx-background-color: #c07840; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-width: 0; -fx-padding: 11 28 11 28; -fx-cursor: hand;" text="LOG IN" />
                        </children>
                     </StackPane>

                     <!-- Divider -->
                     <Separator style="-fx-background-color: #dddddd;">
                         <VBox.margin><Insets bottom="6" top="6" /></VBox.margin>
                     </Separator>

                     <!-- Don't have an account -->
                     <Label maxWidth="Infinity" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-alignment: CENTER;" text="Don't have an account?" />

                     <!-- Sign up button -->
                     <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSignUp" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 12 20 12 20; -fx-cursor: hand;" text="SIGN UP FOR SOULEEA" />

                     <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-cursor: hand;" text="Go Back" />
                  </children>
              </VBox>
           </children>
       </VBox>
   </children>
</StackPane>
