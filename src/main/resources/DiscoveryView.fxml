                                <Circle radius="16" style="-fx-fill: #C17B3A;"/><Label text="▶" style="-fx-font-size: 10px; -fx-text-fill: white;"/>
                            </StackPane>
                        </StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;" spacing="2">
