                    spacing="0">

                    <!-- Album art area -->
                    <StackPane prefWidth="220" prefHeight="175" style="-fx-background-radius: 18 18 0 0; -fx-background-color: #5A4035;">
                        <ImageView fx:id="gotoAlbumArt"
                            fitWidth="220" fitHeight="175"
                            preserveRatio="false"/>
                    </StackPane>

                    <!-- Player info -->
                    <VBox spacing="8" style="-fx-padding: 14 16 16 16; -fx-background-color: #3D2C1E; -fx-background-radius: 0 0 18 18;">
