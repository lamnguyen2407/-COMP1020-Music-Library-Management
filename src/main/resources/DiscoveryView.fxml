        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Trending Song" style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>
                <Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #8B6F47; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane fx:id="trendingCard1" prefWidth="165" prefHeight="215" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-cursor: hand;">
