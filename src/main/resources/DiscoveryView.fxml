<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.ProgressBar?>

<ScrollPane
    fx:id="discoveryScrollPane"
    fitToWidth="true"
    hbarPolicy="NEVER"
    vbarPolicy="AS_NEEDED"
    style="-fx-background: #F2EDE6; -fx-background-color: #F2EDE6; -fx-border-color: transparent;"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.musicapp.ui.DiscoveryController">

    <VBox
        fx:id="contentRoot"
        spacing="32"
        style="-fx-background-color: #F2EDE6; -fx-padding: 28 32 40 32;">

        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Trending Song" style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>
                <Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #8B6F47; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane fx:id="trendingCard1" prefWidth="165" prefHeight="215" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0; -fx-background-color: #C9B49A;">
                            <ImageView fx:id="trending1AlbumArt" fitWidth="165" fitHeight="160" preserveRatio="false"/>
                            <StackPane StackPane.alignment="BOTTOM_RIGHT" style="-fx-padding: 0 10 10 0;">
                                <Circle radius="16" style="-fx-fill: #C17B3A;"/><Label text="▶" style="-fx-font-size: 10px; -fx-text-fill: white;"/>
                            </StackPane>
                        </StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;" spacing="2">
                            <Label fx:id="trending1Title" text="Trending 1" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold;"/><Label fx:id="trending1Artist" text="Artist 1" style="-fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </StackPane>
                <StackPane fx:id="trendingCard2" prefWidth="165" prefHeight="215" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0;"><ImageView fx:id="trending2AlbumArt" fitWidth="165" fitHeight="160" preserveRatio="false"/></StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;"><Label fx:id="trending2Title" text="Trending 2" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold;"/><Label fx:id="trending2Artist" text="Artist 2" style="-fx-font-size: 11px;"/></VBox>
                    </VBox>
                </StackPane>
                <StackPane fx:id="trendingCard3" prefWidth="165" prefHeight="215" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0;"><ImageView fx:id="trending3AlbumArt" fitWidth="165" fitHeight="160" preserveRatio="false"/></StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;"><Label fx:id="trending3Title" text="Trending 3" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold;"/><Label fx:id="trending3Artist" text="Artist 3" style="-fx-font-size: 11px;"/></VBox>
                    </VBox>
                </StackPane>
                <StackPane fx:id="trendingCard4" prefWidth="165" prefHeight="215" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0;"><ImageView fx:id="trending4AlbumArt" fitWidth="165" fitHeight="160" preserveRatio="false"/></StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;"><Label fx:id="trending4Title" text="Trending 4" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold;"/><Label fx:id="trending4Artist" text="Artist 4" style="-fx-font-size: 11px;"/></VBox>
                    </VBox>
                </StackPane>
            </HBox>
        </VBox>

        <VBox spacing="10">
            <Label text="Updated Playlist" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <StackPane fx:id="todaysHitBanner" prefHeight="300" style="-fx-background-color: #1A1A1A; -fx-background-radius: 10;">
                <children>
                    <ImageView fx:id="bannerImage" fitWidth="800" fitHeight="300" preserveRatio="false" style="-fx-opacity: 0.7;" />
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <padding><Insets left="40"/></padding>
                        <Label text="Today's Hits" style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" />
                        <Label text="The biggest tracks on everyone's mind." style="-fx-text-fill: white;" />
                    </VBox>
                </children>
            </StackPane>
        </VBox>

        <HBox spacing="20" alignment="TOP_LEFT" fillHeight="false">
            <VBox spacing="10" prefWidth="280">
                <Label text="Top Artist" style="-fx-font-family: 'Georgia'; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="01" /><ImageView fx:id="artist1Avatar" fitWidth="44" fitHeight="44" /><VBox><Label fx:id="artist1Name" text="Artist"/><Label fx:id="artist1Plays" text="Plays"/></VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="02" /><ImageView fx:id="artist2Avatar" fitWidth="44" fitHeight="44" /><VBox><Label fx:id="artist2Name" text="Artist"/><Label fx:id="artist2Plays" text="Plays"/></VBox>
                </HBox>
                </VBox>

            <VBox spacing="8" prefWidth="260" HBox.hgrow="ALWAYS">
                <Label text="Recent Played" style="-fx-font-family: 'Georgia'; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fx:id="recent1AlbumArt" fitWidth="38" fitHeight="38" /><VBox><Label fx:id="recent1Title" text="Song"/><Label fx:id="recent1Artist" text="Artist"/></VBox><Label fx:id="recent1Like" text="♥" style="-fx-text-fill: #C17B3A;"/>
                </HBox>
                </VBox>

            <VBox spacing="10" prefWidth="220">
                <Label text="Your Go-To Song" style="-fx-font-family: 'Georgia'; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <VBox style="-fx-background-color: #3D2C1E; -fx-background-radius: 18;">
                    <ImageView fx:id="gotoAlbumArt" fitWidth="220" fitHeight="175" preserveRatio="false"/>
                    <VBox spacing="8" style="-fx-padding: 14;">
                        <Label fx:id="gotoTitle" text="Title" style="-fx-text-fill: white;"/>
                        <Label fx:id="gotoArtist" text="Artist" style="-fx-text-fill: #A89070;"/>
                        <ProgressBar fx:id="playerProgress" progress="0.35" prefWidth="188" />
                    </VBox>
                </VBox>
            </VBox>
        </HBox>

        <VBox spacing="14">
            <Label text="New Album Release" style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="14">
                <StackPane prefWidth="175" prefHeight="220" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14;"><VBox><ImageView fx:id="newAlbum1AlbumArt" fitWidth="175" fitHeight="165" /><Label fx:id="newAlbum1Title" text="Album 1"/><Label fx:id="newAlbum1Artist" text="Artist 1"/></VBox></StackPane>
                <StackPane prefWidth="175" prefHeight="220" style="-fx-background-color: #E8DDD0; -fx-background-radius: 14;"><VBox><ImageView fx:id="newAlbum2AlbumArt" fitWidth="175" fitHeight="165" /><Label fx:id="newAlbum2Title" text="Album 2"/><Label fx:id="newAlbum2Artist" text="Artist 2"/></VBox></StackPane>
                </HBox>
        </VBox>

        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT"><Label text="Latest Song" style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold;"/><Label text="›" /></HBox>
            <GridPane hgap="10" vgap="10">
                <columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/></columnConstraints>
                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <ImageView fx:id="latest1AlbumArt" fitWidth="36" fitHeight="36" /><VBox><Label fx:id="latest1Title" text="Song 1"/><Label fx:id="latest1Artist" text="Artist 1"/></VBox><Label text="♥" style="-fx-text-fill: #C17B3A;"/>
                </HBox>
                </GridPane>
        </VBox>
    </VBox>
</ScrollPane>