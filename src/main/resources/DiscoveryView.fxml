            <!-- ── YOUR GO-TO SONG (Now Playing Card) ── -->
            <VBox spacing="10" prefWidth="220" maxWidth="220" HBox.hgrow="NEVER">
                <Label text="Your Go-To Song" style="-fx-font-family: 'Georgia'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>

                <VBox
                    style="-fx-background-color: #3D2C1E; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);"
