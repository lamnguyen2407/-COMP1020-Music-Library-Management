                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="recent4Title" text="" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>
                        <Label fx:id="recent4Artist" text="" style="-fx-font-size: 11px; -fx-text-fill: #8B7563;"/>
