                    <Label text="01" style="-fx-font-size: 12px; -fx-text-fill: #A08060; -fx-min-width: 22;"/>
                    <StackPane>
                        <Circle fx:id="artist1AvatarClip" radius="22" style="-fx-fill: #C9B49A;"/>
