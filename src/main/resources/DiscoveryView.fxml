        <!--              TRENDING SONG                  -->
        <!-- ═══════════════════════════════════════════ -->
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label
                    text="Trending Song"
                    style="-fx-font-family: 'Georgia'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>
                <Label
                    text="›"
                    style="-fx-font-size: 18px; -fx-text-fill: #8B6F47; -fx-cursor: hand;"/>
            </HBox>

            <!-- Trending Cards Row — all 4 cards same size: 165×215, art 165×160 -->
            <HBox spacing="14" alignment="CENTER_LEFT">

                <!-- Card 1 -->
                <StackPane
                    fx:id="trendingCard1"
                    prefWidth="165" prefHeight="215"
                    style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 3); -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0; -fx-background-color: #C9B49A;">
                            <ImageView fx:id="trending1AlbumArt"
                                fitWidth="165" fitHeight="160"
                                preserveRatio="false"/>
                            <!-- Play button — bottom-right, centered icon -->
                            <StackPane StackPane.alignment="BOTTOM_RIGHT" style="-fx-padding: 0 10 10 0;">
                                <Circle radius="16" style="-fx-fill: #C17B3A;"/>
                                <Label text="▶" style="-fx-font-size: 10px; -fx-text-fill: white; -fx-padding: 0 0 0 3;"/>
                            </StackPane>
                        </StackPane>
                        <VBox style="-fx-padding: 8 10 10 10; -fx-background-color: #EDE4D9; -fx-background-radius: 0 0 14 14;" spacing="2">
                            <Label fx:id="trending1Title" text="" style="-fx-font-family: 'Georgia'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2C2316;"/>
                            <Label fx:id="trending1Artist" text="" style="-fx-font-size: 11px; -fx-text-fill: #7A6652;"/>
                        </VBox>
                    </VBox>
                </StackPane>

                <!-- Card 2 -->
                <StackPane
                    fx:id="trendingCard2"
                    prefWidth="165" prefHeight="215"
                    style="-fx-background-color: #E8DDD0; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 3); -fx-cursor: hand;">
                    <VBox alignment="BOTTOM_LEFT">
                        <StackPane prefWidth="165" prefHeight="160" style="-fx-background-radius: 14 14 0 0; -fx-background-color: #B8A898;">
                            <ImageView fx:id="trending2AlbumArt"
                                fitWidth="165" fitHeight="160"
                                preserveRatio="false"/>
