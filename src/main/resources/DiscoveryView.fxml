                        <Label fx:id="artist1Plays" text="" style="-fx-font-size: 11px; -fx-text-fill: #8B7563;"/>
                    </VBox>
                    <Label text="✓" style="-fx-font-size: 14px; -fx-text-fill: #C17B3A;"/>
